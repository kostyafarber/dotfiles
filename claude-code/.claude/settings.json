{
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.dotfiles/claude-code/mods/open-files:~/.dotfiles/claude-code/mods/prs:~/.dotfiles/claude-code/mods/diagrams:~/.dotfiles/claude-code/mods/code:~/.dotfiles/claude-code/mods/rex-tabs",
    "CLAUDE_CODE_FORCE_TERMINAL_IMAGES": "1"
  },
  "attribution": {
    "commit": ""
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$REX_SESSION\" ] || terminal-notifier -title \"٩(◕‿◕)۶\" -message \"Claudopilis NEEDS you\" -sender com.todesktop.230313mzl4w4u92"
          }
        ]
      },
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-notify-hook",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-notify-hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-notify-hook",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "tldraw-offline",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/kostyafarber/skills/tldraw-offline/inject-server-context.mjs' SubagentStart"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "paper-desktop@paper": true,
    "swift-lsp@claude-plugins-official": true,
    "ralph-wiggum@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "paper": {
      "source": {
        "source": "github",
        "repo": "paper-design/agent-plugins"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "permissions": {
    "ask": [
      "Read(~/Library/Mobile Documents/com~apple~CloudDocs/Journal/**)",
      "Edit(~/Library/Mobile Documents/com~apple~CloudDocs/Journal/**)"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "agentPushNotifEnabled": true
}
