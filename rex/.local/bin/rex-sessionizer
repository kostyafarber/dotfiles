#!/usr/bin/env bash

# Fuzzy-pick a project and open it in Rex: the open_project action (init.lua)
# switches to its session, creating it with the Neovim + Claude layout the
# first time. Uses the same TMUX_SESSIONIZER_PATHS / _EXTRA_PATHS roots as
# tmux-sessionizer.
#
# usage: rex-sessionizer [--client CLIENT] [dir]
#   --client  the Rex client to switch (defaults to the first connected app)

set -uo pipefail

# Launched from a Rex action this runs without the interactive shell config, so
# fzf would miss the theme and draw on a transparent background.
export FZF_DEFAULT_OPTS_FILE=${FZF_DEFAULT_OPTS_FILE:-$HOME/.local/state/theme/fzf.conf}

client=""
if [[ ${1:-} == --client ]]; then
    client=$2
    shift 2
fi

if [[ $# -eq 1 ]]; then
    selected=$1
else
    split_dirs() {
        local line p
        while IFS= read -r line; do
            [[ -z $line ]] && continue
            # shellcheck disable=SC2206
            IFS=':' parts=($line)
            for p in "${parts[@]}"; do
                [[ -d $p ]] && printf '%s\n' "$p"
            done
        done <<< "$1"
    }

    paths=()
    while IFS= read -r p; do paths+=("$p"); done \
        < <(split_dirs "${TMUX_SESSIONIZER_PATHS:-$HOME/repos}")

    extras=()
    while IFS= read -r p; do extras+=("$p"); done \
        < <(split_dirs "${TMUX_SESSIONIZER_EXTRA_PATHS:-$HOME/.dotfiles}")

    selected=$( { [[ ${#extras[@]} -gt 0 ]] && printf '%s\n' "${extras[@]}"
                  [[ ${#paths[@]} -gt 0 ]] && fd -L --type d --max-depth 1 . "${paths[@]}" 2>/dev/null
                } | fzf --reverse --prompt="project> " --border)
fi

[[ -z $selected ]] && exit 0

if [[ -z $client ]]; then
    client=$(rex client ls --json | jq -r '[.clients[] | select(.info.kind == "app")][0].client_id // empty')
fi
[[ -z $client ]] && { echo "rex-sessionizer: no Rex app connected" >&2; exit 1; }

rex -C "$client" do open_project dir="$selected" > /dev/null
