#!/usr/bin/env bash
# rv: read and write the review open in the user's nvim (review.nvim + lua/review_ext), the way
# `hunk session comment …` drives a live Hunk window. Talks to the nvim whose Rex-tab socket
# (/tmp/rex-nvim-$UID/<window>.sock) has review_ext loaded and a cwd inside the target repo.
#
#   rv [--repo DIR] list                                  all comments and replies, as JSON
#   rv [--repo DIR] add FILE LINE[-END] [--type T] [--old] [--focus] TEXT
#   rv [--repo DIR] reply ID [--focus] TEXT               reply in the thread (as claude)
#   rv [--repo DIR] resolve ID | reopen ID                mark a thread resolved, or open again
#   rv [--repo DIR] goto ID                               move the user's view to a comment
#   rv [--repo DIR] rm ID
#
# FILE is relative to the repo root. T is note|suggestion|issue|praise (default note).
set -euo pipefail

repo=$PWD
if [[ "${1:-}" == --repo ]]; then repo=$2; shift 2; fi
root=$(git -C "$repo" rev-parse --show-toplevel)
cmd=${1:?usage: rv [--repo DIR] list|add|reply|goto|rm ...}
shift

die() { echo "rv: $*" >&2; exit 1; }

# The socket of an nvim with review_ext loaded whose cwd is inside $root.
find_socket() {
	local probe='luaeval("(package.loaded.review_ext and 1 or 0) .. \"\t\" .. vim.fn.getcwd()")'
	for sock in /tmp/rex-nvim-"$(id -u)"/*.sock; do
		[[ -S "$sock" ]] || continue
		local out loaded cwd
		out=$(nvim --headless --server "$sock" --remote-expr "$probe" </dev/null 2>/dev/null) || continue
		loaded=${out%%$'\t'*} cwd=${out#*$'\t'}
		[[ "$loaded" == 1 ]] || continue
		[[ "$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" == "$root" ]] && { echo "$sock"; return; }
	done
	return 1
}

sock=$(find_socket) || die "no review open for $root (open one with: nvim -c Review, in a Rex tab)"

call() {
	local out
	out=$(nvim --headless --server "$sock" --remote-expr \
		"luaeval('require(\"review_ext\").call(_A)', $(jq -Rn --arg s "$1" '$s'))" </dev/null)
	if jq -e '.error' <<<"$out" >/dev/null; then die "$(jq -r .error <<<"$out")"; fi
	jq '.result' <<<"$out"
}

case $cmd in
list) call '{"cmd":"list"}' ;;
add)
	file=${1:?file}; lines=${2:?line or line-end}; shift 2
	type=note side=new focus=false
	while [[ "${1:-}" == --* ]]; do
		case $1 in
		--type) type=$2; shift 2 ;;
		--old) side=old; shift ;;
		--focus) focus=true; shift ;;
		*) die "unknown flag $1" ;;
		esac
	done
	text=${1:?text}
	line=${lines%-*} end=${lines#*-}
	[[ "$end" == "$lines" ]] && end=null
	call "$(jq -cn --arg f "$file" --argjson l "$line" --argjson e "$end" --arg t "$type" \
		--arg s "$side" --argjson fo "$focus" --arg x "$text" \
		'{cmd:"add", file:$f, line:$l, line_end:$e, type:$t, side:$s, focus:$fo, text:$x}')" |
		jq -r '"added \(.id) at \(.file):\(.line)"'
	;;
reply)
	id=${1:?id}; shift
	focus=false
	[[ "${1:-}" == --focus ]] && { focus=true; shift; }
	call "$(jq -cn --arg i "$id" --arg x "${1:?text}" --argjson fo "$focus" '{cmd:"reply", id:$i, text:$x, focus:$fo}')" |
		jq -r '"replied to \(.id) (\(.replies | length) replies)"'
	;;
resolve | reopen)
	want=true; [[ $cmd == reopen ]] && want=false
	call "$(jq -cn --arg i "${1:?id}" --argjson r "$want" '{cmd:"resolve", id:$i, resolved:$r}')" |
		jq -r 'if .resolved then "resolved \(.id)" else "reopened \(.id)" end'
	;;
goto) call "$(jq -cn --arg i "${1:?id}" '{cmd:"goto", id:$i}')" | jq -r '"showing \(.file):\(.line)"' ;;
rm) call "$(jq -cn --arg i "${1:?id}" '{cmd:"rm", id:$i}')" >/dev/null && echo "removed $1" ;;
*) die "unknown command $cmd" ;;
esac
