#!/usr/bin/env bash
# tmux-sessionizer: fzf-pick a repo, attach (or create) a tmux session in it with nvim.

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find ~/repos -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
        | sed "s|$HOME/repos/||" \
        | fzf --prompt "repo> " --height 60% --reverse)
    [[ -n $selected ]] && selected="$HOME/repos/$selected"
fi

[[ -z $selected ]] && exit 0

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected" "nvim"
    exit 0
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected" "nvim"
fi

if [[ -z $TMUX ]]; then
    tmux attach -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi
