#!/usr/bin/env bash
# theme — flip nvim, ghostty, and Pi between catppuccin latte (light) and mocha (dark).
#
# Single source of truth: a tiny state file at ~/.local/state/theme/mode holding
# "dark" or "light". Every running nvim and Pi session watches it and restyles
# itself instantly; new instances read it on startup. Ghostty has no external
# reload, so we rewrite its `theme =` line (new windows pick it up) and best-effort
# trigger the reload_config keybind (default cmd+shift+,) for windows already open.
#
#   theme            # toggle
#   theme dark|light # set explicitly
#   theme status     # print current mode
set -euo pipefail

# Theme lives in its own include file OUTSIDE the ghostty config tree (config has
# `config-file = ?~/.local/state/theme/ghostty.conf`) so toggling never dirties the
# git-tracked config, and ghostty never re-enters its own config dir — an include
# sitting beside `config` makes ghostty load it twice and report "cycle detected".
STATE_DIR="$HOME/.local/state/theme"
STATE_FILE="$STATE_DIR/mode"
GHOSTTY_CONFIG="$STATE_DIR/ghostty.conf"

# mode -> app theme names
# Ghostty names resolve to matching files in ghostty/themes/; Pi names resolve in ~/.pi/agent/themes/.
ghostty_theme() { [[ "$1" == dark ]] && echo "catppuccin-mocha" || echo "catppuccin-latte"; }
pi_theme() { [[ "$1" == dark ]] && echo "catppuccin-mocha-clean" || echo "catppuccin-latte-clean"; }

current() {
  if [[ -r "$STATE_FILE" ]]; then tr -d '[:space:]' < "$STATE_FILE"; else echo light; fi
}

mode="${1:-toggle}"
case "$mode" in
  dark | light) ;;
  toggle) [[ "$(current)" == dark ]] && mode=light || mode=dark ;;
  status) current; exit 0 ;;
  -h | --help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "theme: unknown arg '$mode' (use dark|light|toggle|status)" >&2; exit 2 ;;
esac

# 1. Persist the mode. Write in place (stable inode) so nvim's fs watcher keeps firing.
mkdir -p "$STATE_DIR"
printf '%s\n' "$mode" > "$STATE_FILE"

# 2. Rewrite ghostty's theme line (replace existing, else append).
gtheme="$(ghostty_theme "$mode")"
ptheme="$(pi_theme "$mode")"
if [[ -f "$GHOSTTY_CONFIG" ]] && grep -qE '^theme = ' "$GHOSTTY_CONFIG"; then
  tmp="$(mktemp)"
  sed -E "s|^theme = .*|theme = ${gtheme}|" "$GHOSTTY_CONFIG" > "$tmp"
  cat "$tmp" > "$GHOSTTY_CONFIG"   # write through the symlink; keep it a regular file
  rm -f "$tmp"
else
  printf 'theme = %s\n' "$gtheme" >> "$GHOSTTY_CONFIG"
fi

# 3. Nudge already-open ghostty windows to reload. Only fire the chord if ghostty
#    is frontmost, so we never inject cmd+shift+, into some other app.
reloaded=0
if command -v osascript >/dev/null 2>&1; then
  front="$(osascript -e 'tell application "System Events" to name of first application process whose frontmost is true' 2>/dev/null || true)"
  if [[ "${front,,}" == ghostty ]]; then
    if osascript -e 'tell application "System Events" to keystroke "," using {command down, shift down}' >/dev/null 2>&1; then
      reloaded=1
    fi
  fi
fi

printf 'theme → %s  (ghostty: %s · nvim: catppuccin-%s · pi: %s)\n' \
  "$mode" "$gtheme" "$([[ $mode == dark ]] && echo mocha || echo latte)" "$ptheme"
if [[ $reloaded -eq 0 ]]; then
  printf '  ↳ open ghostty windows: press ⌘⇧, to reload (new windows already use it)\n'
fi
