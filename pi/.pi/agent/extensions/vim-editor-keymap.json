    },
    {
      "key": "s r",
      "label": "Resume session",
      "action": "app.session.resume"
    },
    {
      "key": "s t",
      "label": "Session tree",
      "action": "app.session.tree"
    },
    {
      "key": "s f",
      "label": "Fork session",
      "action": "app.session.fork"
    },
    {
      "key": "m",
      "label": "Modes",
      "description": "Collaboration mode controls"
    },
    {
      "key": "m d",
      "label": "Design mode",
      "command": "/mode design"
    },
    {
      "key": "m n",
      "label": "Default mode",
      "command": "/mode default"
    },
    {
      "key": "m i",
      "label": "Implement design",
      "command": "/mode implement"
    },
    {
      "key": "u",
      "label": "UI",
      "description": "Display and thinking controls"
    },
    {
      "key": "u o",
      "label": "Toggle tool output",
      "action": "app.tools.expand"
    },
    {
      "key": "u t",
      "label": "Toggle thinking blocks",
      "action": "app.thinking.toggle"
    },
    {
      "key": "u l",
