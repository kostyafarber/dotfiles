    },
    {
      "key": "c",
      "label": "Clipboard viewer",
      "command": "/clipboard"
    },
    {
      "key": "h",
      "label": "Prepare handoff",
      "description": "Prefill a handoff command with the current draft",
      "prefill": "/handoff "
    }
